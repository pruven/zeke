{
  "name": "@pruven/zeke",
  "version": "0.2.1",
  "description": "Automatically copy local environment files into new Git worktrees.",
  "type": "module",
  "bin": {
    "zeke": "dist/bin/zeke.js"
  },
  "files": [
    "dist/bin",
    "dist/lib",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.20.0",
    "bun": ">=1.4.4"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:bun": "bun run build && bun test ./dist/test",
    "check": "tsc --noEmit",
    "build": "tsc",
    "prepare": "npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "vitepress": "^1.6.4",
    "typescript": "~5.9.3",
    "@types/node": "^22.19.0"
  }
}
